  m_SelectionColor: {r: 0.65882355, g: 0.80784315, b: 1, a: 0.7529412}
  m_Text: '# The program should written in a proprietary declarative language.

    #
    Boolean values, integers, decimals, and strings enclosed in double quotes are
    treated as literals.

    # The returned value can be discarded by receiving
    it with an underscore.

    # Any text after the # symbol will be treated as
    a comment.

    # The following functions are available:


    # Game API

    OUT("MoveForward",
    A)

    OUT("MoveBack", A)

    OUT("MoveRight", A)

    OUT("MoveLeft", A)

    OUT("RotateRight",
    A)

    OUT("RotateLeft", A)

    X = KEY("Key name")


    # Logic

    X =
    AND(A, B)

    X = OR(A, B)

    X = NOT(A)

    X = XOR(A, B)

    X = NAND(A,
    B)

    X = NOR(A, B)

    X = XNOR(A, B)


    # Sequence

    X = DFF(D, T)

    X
